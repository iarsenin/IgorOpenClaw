# IgorOpenClaw — /sum only. Copy to ignored .env and chmod 600 .env.
OPENCLAW_AUTH_TOKEN=replace-with-a-random-token

# At least one transcription/summary provider is needed when no transcript exists.
OPENAI_API_KEY=sk-your-openai-api-key
GOOGLE_API_KEY=AIza-your-google-api-key
GEMINI_API_KEY=
SUM_OPENAI_FALLBACK=1
SUM_PROVIDER=gemini
SUM_OPENAI_TEXT_MODEL=gpt-6-luna

# Optional isolated yt-dlp package directory, containing yt_dlp/__init__.py.
SUM_YTDLP_MODULE_DIR=

GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
SUM_EMAIL_TO=igor.arsenin@gmail.com
OPENCLAW_NOTIFY_TARGET=+19179752041
TZ=America/New_York
