{
  // OpenClaw Configuration - IgorOpenClaw
  // Generated into ~/.openclaw/openclaw.json by scripts/setup.sh.
  // Token is injected from .env. Do not hard-code secrets here.

  agents: {
    defaults: {
      model: {
        primary: "openai/gpt-5.4-mini",
        fallbacks: ["google/gemini-2.5-pro"],
      },
      workspace: "~/.openclaw/workspace",
    },
    list: [
      {
        id: "main",
        identity: {
          name: "Sum",
          theme: "transcription, summary, and email server",
        },
      },
    ],
  },

  tools: {
    elevated: {
      enabled: false,
    },
    exec: {
      host: "gateway",
      security: "full",
    },
  },

  commands: {
    native: false,
    nativeSkills: false,
    restart: false,
    ownerDisplay: "raw",
  },

  plugins: {
    load: {
      paths: ["__SUM_PLUGIN_PATH__"],
    },
    allow: ["sum-command", "whatsapp"],
    slots: {
      memory: "none",
    },
    entries: {
      "sum-command": {
        enabled: true,
        config: {},
      },
      whatsapp: {
        enabled: true,
        config: {},
      },
    },
  },

  session: {
    dmScope: "per-account-channel-peer",
  },

  channels: {
    whatsapp: {
      enabled: true,
      responsePrefix: "",
      dmPolicy: "allowlist",
      allowFrom: ["+19179752041"],
      groupPolicy: "disabled",
      groups: {},
      debounceMs: 0,
      accounts: {
        default: {
          enabled: true,
          dmPolicy: "allowlist",
          allowFrom: ["+19179752041"],
          groupPolicy: "disabled",
          groups: {},
          debounceMs: 0,
        },
      },
      mediaMaxMb: 50,
    },
  },

  gateway: {
    port: 18789,
    mode: "local",
    auth: {
      mode: "token",
      token: "__OPENCLAW_AUTH_TOKEN__",
    },
  },
}
